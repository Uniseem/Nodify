{
  "name": "nodify",
  "version": "0.3.0",
  "private": true,
  "engines": { "node": ">=24.18.0" },
  "scripts": {
    "setup": "node tools/build.mjs setup",
    "contracts": "node tools/build.mjs contracts",
    "build": "node tools/build.mjs build",
    "typecheck": "node tools/build.mjs typecheck",
    "test": "node --test tests/*.test.mjs",
    "dev:frontend": "npm --prefix apps/frontend run start:dev",
    "dev:backend": "npm --prefix apps/backend run dev",
    "release": "node tools/release.mjs"
  }
}
